+export function getTelegramPostFromUrl(url) {
+    try {
+        const parsed = new URL(url);
+        if (!['t.me', 'www.t.me', 'telegram.me', 'www.telegram.me'].includes(parsed.hostname)) {
+            return null;
+        }
+        const parts = parsed.pathname.split('/').filter(Boolean);
+        if (parts.length < 2 || !/^\d+$/.test(parts[1])) {
+            return null;
+        }
+        return {
+            channel: parts[0],
+            post: parts[1],
+        };
+    } catch {
+        return null;
+    }
+}
+
+export function isTelegramUrl(url) {
+    return getTelegramPostFromUrl(url) !== null;
+}
+
+export function telegramEmbed(url) {
+    const post = getTelegramPostFromUrl(url);
+    if (!post) return '';
+    return `https://t.me/${post.channel}/${post.post}?embed=1&mode=tme`;
+}
+
 export function embed(video) {
     return `https://www.youtube.com/embed/${getYoutubeIdFromUrl(video)}`;
 }
